# TEMPLATE. Prompt 00 finalises this file and installs it as .github/workflows/lab-monthly.yml.
name: lab-monthly

on:
  schedule:
    - cron: "23 4 1 * *"
  workflow_dispatch: {}

permissions:
  contents: write
  pull-requests: write
  issues: write

jobs:
  report:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - name: Ledger report, demotions and graduation candidates
        run: node scripts/lab/ledger-report.mjs --write labs/ledger/STATUS.md --apply-demotions --candidates labs/.watch/graduation.json
      - name: Commit report and any demotions
        run: |
          git config user.name "qsc-atlas-lab-bot"
          git config user.email "lab-bot@users.noreply.github.com"
          git add labs/ledger/STATUS.md labs/config/autonomy.yaml
          git diff --cached --quiet || git commit -m "chore(lab-monthly): ledger report"
          git push
      - name: Propose graduations as a pull request for Swann
        env:
          GH_TOKEN: ${{ secrets.LAB_BOT_TOKEN }}
        run: node scripts/lab/propose-graduation.mjs labs/.watch/graduation.json
      - name: Open or update the freshness issue
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: node scripts/lab/freshness.mjs --issue
