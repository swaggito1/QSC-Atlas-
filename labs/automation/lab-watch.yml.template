# TEMPLATE. Prompt 00 finalises this file and installs it as .github/workflows/lab-watch.yml.
# Check every "uses:" version against the action's current release before installing.
name: lab-watch

on:
  schedule:
    - cron: "17 5 * * 1"
  workflow_dispatch:
    inputs:
      only:
        description: "Comma-separated watchlist ids to run (blank runs all enabled sources)"
        required: false
        default: ""

concurrency:
  group: lab-watch
  cancel-in-progress: false

permissions:
  contents: write
  pull-requests: write
  issues: write
  id-token: write

jobs:
  fetch:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    outputs:
      changed: ${{ steps.watch.outputs.changed }}
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - name: Install PDF text extraction
        run: sudo apt-get update && sudo apt-get install -y poppler-utils
      - run: npm ci
      - name: Fetch, normalise, hash and diff every enabled source
        id: watch
        run: node scripts/lab/watch.mjs --only "${{ github.event.inputs.only }}" --out labs/.watch/changes.json
      - name: Commit updated snapshots and state
        run: |
          git config user.name "qsc-atlas-lab-bot"
          git config user.email "lab-bot@users.noreply.github.com"
          git add data/lab/watch
          git diff --cached --quiet || git commit -m "chore(lab-watch): update source snapshots"
          git push
      - uses: actions/upload-artifact@v4
        with:
          name: lab-changes
          path: labs/.watch/changes.json
          if-no-files-found: ignore

  triage:
    needs: fetch
    if: needs.fetch.outputs.changed == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v6
        with:
          ref: main
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - uses: actions/download-artifact@v4
        with:
          name: lab-changes
          path: labs/.watch
      - name: Read the pinned triage model from autonomy.yaml
        id: model
        run: node -e "const y=require('yaml');const fs=require('fs');console.log('name='+y.parse(fs.readFileSync('labs/config/autonomy.yaml','utf8')).model.pinned)" >> "$GITHUB_OUTPUT"
      - name: Triage changes into proposals (Claude)
        uses: anthropics/claude-code-action@v1
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          prompt: "/lab-triage labs/.watch/changes.json"
          claude_args: |
            --model ${{ steps.model.outputs.name }}
            --max-turns 60
            --allowedTools "Read,Write,Edit,Glob,Grep,WebFetch,Bash(git show *),Bash(git log *),Bash(node scripts/lab/*),Bash(node labs/tools/style-scan.mjs *)"
      - name: Validate proposals mechanically
        run: node scripts/lab/check-proposals.mjs labs/.watch/proposals
      - name: Open one pull request per proposal
        env:
          GH_TOKEN: ${{ secrets.LAB_BOT_TOKEN }}
        run: node scripts/lab/open-prs.mjs labs/.watch/proposals
