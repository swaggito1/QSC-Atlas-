{
  "name": "qsc-atlas",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "dump": "node --experimental-strip-types scripts/dump-notion.ts",
    "lab:validate": "node scripts/lab/validate.mjs",
    "lab:test": "vitest run",
    "lab:style": "node labs/tools/style-scan.mjs data/lab src data/site scripts/lab scripts/site labs .claude/skills .github/workflows CLAUDE.md vercel.json --exclude=data/lab/watch,labs/.watch,labs/review,data/lab/cascade/candidates.json",
    "lab:check": "npm run lab:validate && npm run lab:test && npm run lab:style",
    "site:matrix": "node scripts/site/build-matrix.mjs",
    "site:check": "node scripts/site/check.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@notionhq/client": "^5.22.0",
    "astro": "^5.5.0",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "diff": "^9.0.0",
    "firecrawl": "^4.25.3",
    "fuse.js": "^7.0.0",
    "node-html-parser": "^9.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "world-countries": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
