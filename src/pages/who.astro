---
import Base from '../layouts/Base.astro';
import '../styles/lab.css';

// The orientation page (brief 4.1 and 9.2): who the Atlas is for, what they get, and how to
// read it. Ink on paper with teal for the interface, no globe. Linked from the hero scene; ends with a link into the map.
// The minimal pass (2 October 2026): the wording is unchanged.
// The épuré pass (4 October 2026): three short answers are one definition list at the reading
// measure, not three heading blocks of one paragraph each: each question a term in the interface
// face at 600, its answer under it in the reading face, a group's gap between them. Open the map
// is the page's one action, the kit's filled button (lab.css .lab-btn--primary), with no arrow.
---

<Base title="Who the Atlas is for" description="Who the QSC Atlas is for, what it gives you, and how to read it: the two axes, the colour rule, the confidence grade.">
  <div class="container who">
    <h1>Who the Atlas is for, and how to read it</h1>

    <dl class="who-list">
      <div>
        <dt>Who it is for</dt>
        <dd class="prose">
          Policymakers comparing national positions; CISOs and advisers scoping a transition across
          jurisdictions; researchers who need sourced, comparable data.
        </dd>
      </div>
      <div>
        <dt>What you get</dt>
        <dd class="prose">
          For any country: the binding instrument and its legal status, the obligation it places on
          organisations, and the deadline it works to. Every
          claim links to the official source behind it.
        </dd>
      </div>
      <div>
        <dt>How to read it</dt>
        <dd class="prose">
          Colour shows only the standards process a country coordinates with. Every country is placed
          on two axes, coordination posture and standards role. Each profile carries a confidence
          grade and a last-verified date. Click a country to open it.
        </dd>
      </div>
    </dl>

    <p class="cta-wrap">
      <a class="lab-btn lab-btn--primary" href="/map">Open the map</a>
    </p>
  </div>
</Base>

<style>
  .who {
    padding-top: var(--page-top);
  }
  .who h1 {
    font-family: var(--font-reading);
    font-weight: var(--weight-heading);
    font-size: var(--type-h1);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-tight);
    margin: 0;
    max-width: var(--measure-heading);
  }
  /* the three answers: a term over its answer, a group's gap between them, at the measure */
  .who-list {
    display: grid;
    gap: var(--gap-group-lg);
    max-width: var(--measure);
    margin: var(--gap-related) 0 0;
  }
  .who-list dt {
    margin: 0 0 var(--gap-mark);
    font-family: var(--font-instrument);
    font-size: var(--type-control);
    font-weight: var(--weight-ui-strong);
    line-height: var(--leading-snug);
    color: var(--ink);
  }
  .who-list dd {
    margin: 0;
  }
  .cta-wrap {
    margin: var(--gap-related) 0 0;
  }
</style>
