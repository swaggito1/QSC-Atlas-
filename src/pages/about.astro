---
import Base from '../layouts/Base.astro';

// Restored from the live page (2 October 2026), with one change Swann decided on 1 October: the
// briefing offer is one plain sentence with the id "briefing", so old /about#briefing links still
// land on it, with no heading and no button. "Dr" takes no full stop, in British style.
// A curated set of the most recognisable participants from the two CEPS Task Forces (2023 and
// 2025), spread across EU institutions, US and national agencies, big tech and academia. Shown as
// one looping row of logos fetched from Brandfetch by domain (grayscale, colour on hover); the
// row is the page's one moving thing, and it pauses under the pointer, while a logo has keyboard
// focus, and stops under reduced motion. A logo that fails to load hides its whole link, so no
// empty link is left for a keyboard to land on.
//
// The minimal pass (2 October 2026): the page top every reading page shares, the H1 at the
// display step, section headings in Newsreader at the section step, a section's gap between
// sections and no rule or teal label. The wording is unchanged.
//
// The épuré pass (4 October 2026): one lede, the first paragraph, at the lede step in ink, and
// the second as body text, so the eye reads them in order; every paragraph at the reading measure.
// Who is behind it and Our Task Forces stand a related gap apart, the participants a subject's
// gap below them. A portrait's alt is empty, since the name beside it in the same link already
// names the person. No arrow after a link. The logo row itself is unchanged (Swann, 4 October
// 2026), motion included.
const partners = [
  // EU institutions
  { n: 'European Parliament', d: 'europarl.europa.eu' },
  { n: 'ETSI', d: 'etsi.org' },
  // US and international institutions
  { n: 'NIST', d: 'nist.gov' },
  { n: 'NATO', d: 'nato.int' },
  // National institutions
  { n: 'ANSSI', d: 'cyber.gouv.fr' },
  { n: 'TNO', d: 'tno.nl' },
  // Industry and big tech
  { n: 'Microsoft', d: 'microsoft.com' },
  { n: 'IBM', d: 'ibm.com' },
  { n: 'Intel', d: 'intel.com' },
  { n: 'Deloitte', d: 'deloitte.com' },
  { n: 'Thales', d: 'thalesgroup.com' },
  // Academic institutions
  { n: 'Stanford University', d: 'stanford.edu' },
  { n: 'KU Leuven', d: 'kuleuven.be' },
  { n: 'Alan Turing Institute', d: 'turing.ac.uk' },
  { n: 'TU Delft', d: 'tudelft.nl' },
  { n: 'École Polytechnique', d: 'polytechnique.edu' },
];
---

<Base title="About">
  <div class="container about">
    <h1>About the QSC Atlas</h1>
    <p class="prose lead">
      An independent, evidence-based reference on how governments are migrating to quantum-safe
      cryptography, built only from official institutional sources and maintained alongside advisory
      work on the transition.
    </p>
    <p class="prose intro">
      The Atlas is maintained within the Cybersecurity@CEPS Initiative at the Centre for European
      Policy Studies. How it classifies countries, and the sources behind every profile, are set out
      in the <a href="/methodology">methodology</a>.
    </p>

    <h2>Who is behind it</h2>
    <ul class="team" id="team">
      <li>
        <a class="person" href="https://www.ceps.eu/ceps-staff/lorenzo-pupillo/" target="_blank" rel="noopener">
          <img
            class="person-photo"
            src="/team/lorenzo-pupillo.jpeg"
            alt=""
            width="179"
            height="270"
            loading="lazy"
          />
          <span class="person-name">Dr Lorenzo Pupillo</span>
          <span class="person-title">Head of the Cybersecurity@CEPS Initiative</span>
        </a>
      </li>
      <li>
        <a class="person" href="https://www.ceps.eu/ceps-staff/swann-ashworth/" target="_blank" rel="noopener">
          <img
            class="person-photo"
            src="/team/swann-ashworth.jpeg"
            alt=""
            width="409"
            height="517"
            loading="lazy"
          />
          <span class="person-name">Swann Ashworth</span>
          <span class="person-title">Associate Research Assistant, GRID Unit</span>
        </a>
      </li>
    </ul>

    <h2>Our Task Forces</h2>
    <ul class="tasks">
      <li>
        <h3>
          <a href="https://www.ceps.eu/ceps-publications/quantum-technologies-and-cybersecurity/" target="_blank" rel="noopener">
            Quantum Technologies and Cybersecurity (2023)
          </a>
        </h3>
        <p class="prose">
          Launched in March 2023, this CEPS Task Force examined the technical, ethical, market and
          governance challenges at the intersection of quantum technologies and cybersecurity. It set
          out policy recommendations for EU institutions, Member States, industry and the research
          community on developing and deploying quantum-safe technologies.
        </p>
      </li>
      <li>
        <h3>
          <a href="https://www.ceps.eu/ceps-publications/strengthening-the-eu-transition-to-a-quantum-safe-world/" target="_blank" rel="noopener">
            Strengthening the EU Transition to a Quantum-Safe World (2025)
          </a>
        </h3>
        <p class="prose">
          Launched in April 2025 as a multi-stakeholder platform, this CEPS Task Force addressed the
          technical, market, governance and policy challenges of Europe's move to post-quantum
          cryptography. It produced practical guidelines and recommendations to accelerate a
          coordinated, secure transition across the public and private sectors.
        </p>
      </li>
    </ul>

    <section class="partners">
      <h3 class="partners-head">Task force participants</h3>
      <p class="prose credibility">The organisations that took part in our two Task Forces, combined.</p>
      <div class="marquees">
        <div class="marquee">
          <div class="track" style="--dur:60s">
            {partners.map((p) => (
              <a class="logo" href={`https://${p.d}`} target="_blank" rel="noopener" aria-label={p.n} title={p.n}>
                <img src={`https://cdn.brandfetch.io/domain/${p.d}?c=1id_IvDZKuDG7x0_nZE`} alt="" loading="lazy" onerror="this.parentElement.style.display='none'" />
              </a>
            ))}
            {partners.map((p) => (
              <a class="logo" href={`https://${p.d}`} target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
                <img src={`https://cdn.brandfetch.io/domain/${p.d}?c=1id_IvDZKuDG7x0_nZE`} alt="" loading="lazy" onerror="this.parentElement.style.display='none'" />
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <p class="prose briefing" id="briefing">
      Lorenzo Pupillo and Swann Ashworth give briefings on the Atlas on request, at
      <a href="mailto:lorenzo.pupillo@ceps.eu">lorenzo.pupillo@ceps.eu</a> or
      <a href="mailto:swann.ashworth@ceps.eu">swann.ashworth@ceps.eu</a>.
    </p>
  </div>
</Base>

<style>
  .about {
    padding-top: var(--page-top);
  }
  .about h1 {
    max-width: var(--measure-heading);
    font-family: var(--font-reading);
    font-size: var(--type-h1);
    font-weight: var(--weight-heading);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--gap-group-lg);
  }
  .about h2 {
    font-family: var(--font-reading);
    font-size: var(--type-section);
    font-weight: var(--weight-heading);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    margin: var(--gap-related) 0 0;
  }
  /* the one lede, in ink at the lede step; the paragraph after it is body text */
  .lead {
    margin: 0;
    font-size: var(--type-lede);
    line-height: var(--leading-normal);
    color: var(--ink);
  }
  .intro {
    margin: var(--gap-group) 0 0;
  }
  .intro a,
  .tasks h3 a,
  .briefing a {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  /* a one-line title link still has a 44px-tall hit area, over the space around it */
  .tasks h3 a {
    position: relative;
  }
  .tasks h3 a::after {
    content: '';
    position: absolute;
    inset: var(--hit-inset);
  }
  .intro a:hover,
  .tasks h3 a:hover,
  .briefing a:hover,
  .intro a:active,
  .tasks h3 a:active,
  .briefing a:active {
    color: var(--accent-strong);
  }
  /* the participants' one line, under their subhead (unchanged with the logo row) */
  .credibility {
    color: var(--ink-muted);
    font-size: var(--type-control);
    margin-top: 0;
  }

  /* Team: clickable portraits that open the CEPS profile. */
  .team {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }
  .person {
    display: grid;
    justify-items: start;
    gap: var(--gap-mark);
    text-decoration: none;
    color: var(--ink);
    max-width: 12rem;
  }
  .person-photo {
    width: 8.5rem;
    height: 10.6rem;
    object-fit: cover;
    border: var(--rule);
    margin-bottom: var(--space-2);
  }
  /* the portrait opens the CEPS profile, so the name reads as the link: teal and underlined */
  .person-name {
    font-family: var(--font-instrument);
    font-weight: var(--weight-ui-strong);
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .person:hover .person-name,
  .person:active .person-name {
    color: var(--accent-strong);
  }
  .person-title {
    font-size: var(--type-small);
    color: var(--ink-muted);
  }

  /* Task forces: title link plus a two-sentence note. */
  .tasks {
    list-style: none;
    margin: var(--gap-group-lg) 0 0;
    padding: 0;
    display: grid;
    gap: var(--gap-group-lg);
  }
  .tasks h3 {
    max-width: var(--measure);
    font-family: var(--font-reading);
    font-size: var(--type-lede);
    font-weight: var(--weight-heading);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-2);
  }
  .tasks .prose {
    color: var(--ink-muted);
    margin: 0;
  }

  /* the one sentence offering briefings, set apart from the logos above it as the section was */
  .briefing {
    margin-top: var(--gap-related);
  }

  /* Participant logos: one looping row, under a Newsreader subhead in ink; the participants are a
     change of subject from the two Task Forces, a subject's gap above them */
  .partners {
    margin-top: var(--gap-subject);
  }
  .partners-head {
    font-family: var(--font-reading);
    font-size: var(--type-lede);
    font-weight: var(--weight-heading);
    line-height: var(--leading-snug);
    color: var(--ink);
    margin: 0 0 var(--space-2);
  }
  .marquees {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-4);
  }
  /* the padding leaves room for a logo's focus ring, which the clipped row would otherwise cut */
  .marquee {
    overflow: hidden;
    padding: var(--space-1);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  .track {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    width: max-content;
    animation: marq var(--dur, 52s) linear infinite;
  }
  .marquee.is-rev .track {
    animation-direction: reverse;
  }
  .marquee:hover .track,
  .marquee:focus-within .track {
    animation-play-state: paused;
  }
  @keyframes marq {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .logo {
    flex: none;
    display: inline-flex;
    align-items: center;
  }
  .logo img {
    height: 60px;
    width: auto;
    max-width: 130px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.65;
    transition: opacity 0.2s ease, filter 0.2s ease;
  }
  .logo:hover img {
    filter: grayscale(0);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .intro a,
    .tasks h3 a,
    .briefing a,
    .person-name {
      transition: none;
    }
    .track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
    }
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
