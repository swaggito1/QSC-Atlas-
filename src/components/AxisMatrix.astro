---
// The two-axis matrix (brief 3.2): coordination posture (columns) by standards role (rows),
// with the country count in each cell, read from the profiles at build. An accessible labelled
// grid: colour appears only as the posture dot beside each column's label, so it reads without
// relying on hue. The row heads are the role badge itself, so the page names each role one way.
// On phones the column heads take the posture's short label from POSTURE_META, so the four
// columns fit; if a narrow screen still cannot hold them, the grid scrolls sideways inside its
// own labelled region, which a keyboard can reach. With no profile loaded the figure is left
// out. Self-contained: it reads the collection itself, so any page can drop it in.
// The épuré pass (4 October 2026): table text at the small step of the interface face (a count in
// mono at the size of its row), the column heads over the one ink rule a table's heads take, and
// hairlines between the rows.
import { getCollection } from 'astro:content';
import RoleBadge from './RoleBadge.astro';
import { POSTURE_ORDER, POSTURE_META, ROLE_ORDER } from '../lib/process';

const countries = await getCollection('countries');
const classified = countries.filter((c) => c.data.coordinationPosture).length;
const cell = (p: string, r: string) =>
  countries.filter((c) => c.data.coordinationPosture === p && c.data.standardsRole === r).length;
const noRole = (p: string) =>
  countries.filter((c) => c.data.coordinationPosture === p && !c.data.standardsRole).length;
---

{
  classified > 0 && (
    <figure class="matrix-fig">
      <div class="matrix-scroll" tabindex="0" role="region" aria-label="Countries by posture and role, scrolls sideways">
        <table class="matrix">
          <caption class="sr-only">Countries by coordination posture (columns) and standards role (rows).</caption>
          <thead>
            <tr>
              <td />
              {POSTURE_ORDER.map((p) => (
                <th scope="col">
                  <span class="sw" style={`--c:${POSTURE_META[p].color}`} aria-hidden="true" />
                  <span class="lab-full">{POSTURE_META[p].label}</span>
                  <span class="lab-short" aria-hidden="true">
                    {POSTURE_META[p].short}
                  </span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {ROLE_ORDER.map((r) => (
              <tr>
                <th scope="row">
                  <RoleBadge value={r} />
                </th>
                {POSTURE_ORDER.map((p) => (
                  <td class="mono">{cell(p, r) || ''}</td>
                ))}
              </tr>
            ))}
            <tr class="none-row">
              <th scope="row">No role recorded</th>
              {POSTURE_ORDER.map((p) => (
                <td class="mono">{noRole(p) || ''}</td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
      <figcaption>
        Counts across the {classified} countries with a coordination posture recorded. Colour marks the posture only;
        every cell is labelled. The last row counts countries with a posture but no standards role recorded, the
        engaged but unaligned among them.
      </figcaption>
    </figure>
  )
}

<style>
  .matrix-fig {
    margin: var(--gap-group-lg) 0;
  }
  /* The matrix scrolls sideways in its own container rather than stretching the page (the page
     body must never scroll horizontally). */
  .matrix-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .matrix {
    border-collapse: collapse;
    font-size: var(--type-small);
  }
  .matrix th {
    font-weight: var(--weight-ui);
    text-align: left;
    color: var(--ink);
    padding: var(--space-2) var(--space-3);
    vertical-align: bottom;
  }
  .matrix thead th {
    font-family: var(--font-instrument);
    font-size: var(--type-small);
    line-height: var(--leading-snug);
  }
  .matrix tbody th {
    font-family: var(--font-instrument);
    font-size: var(--type-small);
    color: var(--ink-muted);
    white-space: nowrap;
    border-top: var(--rule);
  }
  /* the one ink rule under the column heads */
  .matrix tbody tr:first-child > * {
    border-top: var(--rule-head);
  }
  .matrix .sw {
    display: inline-block;
    width: 0.6em;
    height: 0.6em;
    border-radius: var(--radius-mark);
    background: var(--c);
    margin-right: 0.4em;
  }
  .matrix .lab-short {
    display: none;
  }
  .matrix td {
    text-align: center;
    padding: var(--space-2) var(--space-3);
    border-top: var(--rule);
    color: var(--ink);
    min-width: 3.2em;
  }
  /* the empty corner above the row heads carries no rule */
  .matrix thead td {
    border-top: none;
  }
  @media (max-width: 639px) {
    .matrix th,
    .matrix td {
      padding: var(--space-2) var(--space-1);
    }
    .matrix td {
      min-width: 2.4em;
    }
    /* the badge may break at its hyphen, and the column heads take the short labels */
    .matrix tbody th,
    .matrix tbody th :global(.role-badge) {
      white-space: normal;
    }
    .matrix .lab-full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .matrix .lab-short {
      display: inline;
    }
  }
  .matrix-fig figcaption {
    margin-top: var(--space-2);
    font-size: var(--type-small);
    color: var(--ink-muted);
    max-width: var(--measure);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
