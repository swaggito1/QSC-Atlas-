---
// The view switch (spec 3.5): the kit's text tabs (lab.css .lab-switch) between the views of one
// section, "List, Map, Target dates" on Countries and "Overview, Cascade" on Standards (5 October
// 2026), from nav.viewSwitch(), which lists built views only. The current view carries
// aria-current, ink at weight 600 and the 2px teal underline. One view alone is no switch, so
// nothing renders.
import { viewSwitch } from './contracts';
import type { SwitchItem } from './contracts';
import '../../../styles/lab.css';

interface Props {
  section?: 'countries' | 'standards';
  items?: SwitchItem[]; // or pass the items directly
  label?: string;
}
const { section = 'countries', label = 'Views' } = Astro.props;
const items = Astro.props.items ?? viewSwitch(section, Astro.url.pathname);
---

{
  items.length > 1 && (
    <nav class="fr-views" aria-label={label}>
      <ul class="lab-switch">
        {items.map((v) => (
          <li>
            <a href={v.href} aria-current={v.current ? 'page' : undefined}>
              {v.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
