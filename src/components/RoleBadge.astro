---
// The standards-role annotation: whose algorithms a country runs. Rendered as muted text in
// sentence case at the small step, weight 400, not a second boxed chip competing with the
// posture. Renders nothing when no role is recorded.
import { roleMeta } from '../lib/process';

interface Props {
  value: string | null | undefined;
  short?: boolean;
}
const { value, short = false } = Astro.props;
const meta = roleMeta(value);
---

{meta && <span class="role-badge">{short ? meta.short : meta.label}</span>}

<style>
  .role-badge {
    font-family: var(--font-instrument);
    font-size: var(--type-small);
    font-weight: var(--weight-ui);
    color: var(--ink-muted);
    white-space: nowrap;
  }
</style>
