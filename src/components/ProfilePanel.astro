---
// The country profile (spec 7.1). One question: what has this government published, and how
// binding is it. The answer first, the evidence one step away (the minimal pass, 2 October 2026).
// Top to bottom: the title block and the EU membership line; the migration timeline, first on
// every profile (Swann, 2 October 2026); the at-a-glance rail (beside the reading column on wide
// screens, under the timeline on phones and in print), which holds only what the body does not
// show: the coordination posture with its confidence, the standards role and the Updated date;
// the summary; Across the Atlas; Rules that apply, led by the bindingness in words; standards,
// algorithms and the hybrid stance; international standards processes; governmental and
// standards bodies; the EU's Member States (on the EU profile); the key institutional documents,
// the first ten then the rest behind "Show all"; About this page, a closed disclosure at the foot.
//
// Sections are Newsreader headings in ink with no rule between them, spaced by subject (the épuré
// pass, 4 October 2026): the timeline, the summary and Across the Atlas are one subject, a related
// gap apart; Rules that apply, Standards and algorithms and the documents each open a new
// question, a subject's gap above them; the processes, the bodies and the Member States follow
// the standards as their next facets. Every list whose rows are links (the bodies, the Member
// States, the documents) sets its names in ink on a thin teal underline (global.css .row-link).
// Nothing is said twice: the timeline's shared row words are one line, the rail repeats none of
// the body, and About this page holds only the sources, the citation and corrections.
//
// A profile with no timeline keeps the quiet empty line in the timeline's place, so every full
// profile has one shape and the absence is the first thing read. A Placeholder profile shows the
// timeline only when it has lines (none does today): its page stays one invitation, not a row of
// empty sections, and its posture stays in its title block, since it has no rail.
//
// The rules the page keeps:
// - no year is ever placed under a legal label: the rail holds no year and no legal label, and
//   the bindingness words lead Rules that apply, which holds no year; a target is never called a
//   deadline;
// - lifecycle status and bindingness are two labels, never one scale, and a proposal reads
//   "Proposal, not law" with no bindingness label;
// - kind, status and bindingness come from the annotations sidecar or are not shown; nothing is
//   inferred from a label, and in production unconfirmed annotations never reach the page;
// - every link into a tool or a gated page goes through link(), pageHref() or standardHref(),
//   which give null when the page is not built, and null renders nothing; nothing links to EU
//   rules, which has left the site;
// - no score, ranking, percentage or tally of the country.
// A Placeholder profile shows only its title block, any timeline lines, any evidence rows that
// reach it, any documents, and one line inviting a missing document.
// The internal analyticalNote field is never read here (see docs/REGULATORY_LAYER_SPEC.md).
import ProcessChip from './ProcessChip.astro';
import RoleBadge from './RoleBadge.astro';
import MigrationTimeline from './MigrationTimeline.astro';
import AcrossTheAtlas from './site/AcrossTheAtlas.astro';
import CiteThis from './site/frame/CiteThis.astro';
import ReportError from './site/frame/ReportError.astro';
import { parseNameRole, parseList } from '../lib/parse';
import { pageHref } from '../lib/site/gates';
import { bindingWords, readRules, readTimeline, standardHref, timelineLinks } from '../lib/site/evidence';
import { joinAnd, loadIssuerAliases, nameInSentence } from '../lib/site/joins';
import { issuerTable, matchesOrg } from '../lib/site/documents';
import { docId } from '../lib/site/docid';
import { correctionHref, citeText } from '../lib/site/cite';
import { formatDay } from '../lib/site/meta';
import '../styles/frame.css';

interface CountryData {
  country: string;
  iso3: string;
  summary?: string | null;
  govActors?: string | null;
  standardFamilies?: string | null;
  algorithms?: string | null;
  coordinationPosture?: string | null;
  standardsRole?: string | null;
  mainRegulation?: string | null;
  legalStatus?: string | null;
  obligation?: string | null;
  confidence?: string | null;
  processParticipation?: string | null;
  hybridDeployment?: string | null;
  migrationTimeline?: string | null;
  targetCompletion?: string | null;
  verificationStatus?: string | null;
  lastUpdated?: string | null;
  dataStatus?: string | null;
}
interface DocData {
  title: string;
  issuingOrg?: string | null;
  year?: number | null;
  tier?: string | null;
  url?: string | null;
}
interface Member {
  iso3: string;
  name: string;
  href: string | null;
}
interface Props {
  country: CountryData;
  documents?: DocData[];
  isMember?: boolean; // an EU Member State (data/lab/shared/memberships.json)
  members?: Member[]; // the EU profile only: the 27 Member States
  mirrorNote?: boolean; // preview only: the Notion fields differ from data/profiles
  dataAsOf?: string | null; // the latest profile Updated date, for the Placeholder line
}
const {
  country,
  documents = [],
  isMember = false,
  members = [],
  mirrorNote = false,
  dataAsOf = null,
} = Astro.props;

const iso3 = country.iso3.toUpperCase();
const path = `/countries/${iso3.toLowerCase()}`;
const name = country.country;
const inSentence = nameInSentence(name);
const placeholder = country.dataStatus === 'Placeholder';
const euHref = isMember ? pageHref('/countries/euu') : null;

// ---- rules that apply, the rail's bindingness and the timeline, read once (evidence.ts) ---------

const regulations = readRules(iso3, country.mainRegulation);
const { words: bindingText, scopeNote } = bindingWords(country.legalStatus, regulations);
const timeline = readTimeline(iso3, country.migrationTimeline, isMember);
const phased = country.targetCompletion === 'Phased (no fixed end)';
// the same rules as the dates row of Across the Atlas (evidence.ts)
const tlLinks = timelineLinks(iso3, country.migrationTimeline);

// ---- standards, bodies, documents ------------------------------------------------------------

const families = parseList(country.standardFamilies);
const algorithms = parseList(country.algorithms);
/** A standard's page for a name as the profile writes it ("NIST FIPS 203" finds FIPS 203). */
const stdHref = (n: string) => standardHref(n) ?? (/^NIST\s+/i.test(n) ? standardHref(n.replace(/^NIST\s+/i, '')) : null);
const familyItems = families.map((f) => ({ text: f, href: stdHref(f) }));
const algorithmItems = algorithms.map((a) => ({ text: a, href: stdHref(a) }));
const govActors = parseNameRole(country.govActors);
const participation = parseNameRole(country.processParticipation);
// an issuer opens this country's documents under that name (an acronym such as NCSC is shared
// across borders), and is linked only when this profile holds at least one of them
const issuers = issuerTable(loadIssuerAliases().aliases);
const orgLink = (org: string) =>
  documents.some((d) => matchesOrg({ issuingOrg: d.issuingOrg ?? null, country: iso3 }, org, issuers))
    ? pageHref(`/documents?country=${iso3}&org=${encodeURIComponent(org)}`)
    : null;

// the documents as a compact list, newest first: title, issuer and year, with its entry in
// Documents; the notes and the tier are one step away, on that entry
const docs = [...documents]
  .sort((a, b) => (b.year ?? -Infinity) - (a.year ?? -Infinity) || a.title.localeCompare(b.title, 'en-GB'))
  .map((d) => {
    const id = d.url ? docId(d.url) : null;
    return {
      ...d,
      meta: [d.issuingOrg, d.year].filter((v) => v !== null && v !== undefined && v !== '').join(' · '),
      rowHref: id ? pageHref(`/documents?country=${iso3}#doc-${id}`) : null,
    };
  });
const DOCS_SHOWN = 10; // the first ten stand open; "Show all" discloses the rest
const docGroups = [
  { items: docs.slice(0, DOCS_SHOWN), more: false },
  { items: docs.slice(DOCS_SHOWN), more: true },
].filter((g) => g.items.length > 0);
const allDocsHref = docs.length ? pageHref(`/documents?country=${iso3}`) : null;
const tierCounts = (() => {
  const counts = new Map<string, number>();
  for (const d of docs) if (d.tier) counts.set(d.tier, (counts.get(d.tier) ?? 0) + 1);
  return [...counts.entries()]
    .sort((a, b) => a[0].localeCompare(b[0]))
    .map(([tier, n]) => `${n} ${/^T\d$/.test(tier) ? `tier ${tier.slice(1)}` : tier}`);
})();
const methodSources = pageHref('/methodology#sources');

// ---- the rail, the rules' lead line and About this page ----------------------------------------

// the bindingness in words leads Rules that apply; with no instrument listed it says only what
// the empty line under it does not already say
const bindingLine = bindingText && (regulations.length > 0 || bindingText !== 'None recorded') ? `${bindingText}${scopeNote ? `; ${scopeNote}` : ''}.` : null;

const verifiedLabel =
  country.verificationStatus === 'Verified'
    ? 'Verified against sources'
    : country.verificationStatus === 'Corrected'
      ? 'Corrected from sources'
      : null;
const updated = formatDay(country.lastUpdated);
const citation = citeText({ title: `${name}: country profile`, path, asOf: country.lastUpdated ?? null });
const reportHref = correctionHref(name, path);
const placeholderAsOf = formatDay(dataAsOf);
// the timeline leads every full profile, with its empty line where it has none; a Placeholder
// shows it only when it has lines
const showTimeline = !placeholder || timeline.length > 0;
const hybrid = country.hybridDeployment?.trim() || 'None stated';
---

<article class:list={['profile', { 'is-placeholder': placeholder }]}>
  {mirrorNote && <p class="mirror-note">The JSON copy of this profile differs from Notion; run the dump.</p>}
  <header class="profile-head">
    <div class="title-row">
      <h1>{name}</h1>
      {
        placeholder && (
          <>
            <ProcessChip value={country.coordinationPosture} />
            {country.standardsRole && <RoleBadge value={country.standardsRole} />}
          </>
        )
      }
    </div>
    {
      isMember && (
        <p class="member-line">
          EU Member State
          {euHref && (
            <>
              <span class="sep" aria-hidden="true">
                ·
              </span>
              <a href={euHref}>The EU's profile</a>
            </>
          )}
        </p>
      )
    }
  </header>

  <div class:list={['profile-body', { 'is-placeholder': placeholder, 'has-lead': showTimeline }]}>
    {
      showTimeline && (
        <section class="lead-block" id="timeline" aria-labelledby="timeline-h">
          <h2 class="section-h" id="timeline-h">Migration timeline</h2>
          <MigrationTimeline rows={timeline} name={inSentence} phased={phased} />
          {timeline.length > 0 && tlLinks.length > 0 && (
            <p class="tl-links">
              {tlLinks.map((l) => (
                <a href={l.href}>{l.label}</a>
              ))}
            </p>
          )}
        </section>
      )
    }

    {
      !placeholder && (
        <aside class="ataglance" aria-labelledby="ag-h">
          <h2 class="sr-only" id="ag-h">At a glance</h2>
          <dl class="ag-list">
            <div class="ag-item">
              <dt>Coordinates with</dt>
              <dd>
                <ProcessChip value={country.coordinationPosture} />
                {country.coordinationPosture && country.confidence && <span class="ag-sub">{country.confidence} confidence</span>}
              </dd>
            </div>
            {country.standardsRole && (
              <div class="ag-item">
                <dt>Standards role</dt>
                <dd>
                  <RoleBadge value={country.standardsRole} />
                </dd>
              </div>
            )}
            {updated && (
              <div class="ag-item">
                <dt>Updated</dt>
                <dd class="mono">{updated}</dd>
              </div>
            )}
          </dl>
        </aside>
      )
    }

    <div class="profile-main">
      {country.summary ? <p class="prose summary">{country.summary}</p> : !placeholder && <p class="empty summary">No summary in the public record.</p>}

      <AcrossTheAtlas
        input={{
          iso3,
          name,
          posture: country.coordinationPosture ?? null,
          dataStatus: country.dataStatus ?? null,
          migrationTimeline: country.migrationTimeline ?? null,
          mainRegulation: country.mainRegulation ?? null,
          standardFamilies: country.standardFamilies ?? null,
          algorithms: country.algorithms ?? null,
          lastUpdated: country.lastUpdated ?? null,
        }}
      />

      {
        !placeholder && (
          <section class="block block--subject" id="rules" aria-labelledby="rules-h">
            <h2 class="section-h" id="rules-h">Rules that apply</h2>
            {bindingLine && <p class="rules-lead">{bindingLine}</p>}
            {regulations.length ? (
              <ul class="reg-list">
                {regulations.map((r) => (
                  <li>
                    <span class="reg-name">{r.instrument}</span>
                    <span class="reg-tags">
                      {r.level && <span class="reg-level">{r.level}</span>}
                      {r.proposal ? (
                        <span class="reg-pair">
                          <span class="reg-v is-proposal">Proposal, not law</span>
                        </span>
                      ) : (
                        <>
                          {r.status && (
                            <span class="reg-pair">
                              <span class="reg-k">Status</span> <span class="reg-v">{r.status}</span>
                            </span>
                          )}
                          {r.bindingness && (
                            <span class="reg-pair">
                              <span class="reg-k">Bindingness</span>{' '}
                              <span class:list={['reg-v', { 'is-binding': r.bindingness.binding }]}>{r.bindingness.label}</span>
                            </span>
                          )}
                        </>
                      )}
                      {r.scope && <span class="reg-scope">{r.scope}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="empty">No governing instrument recorded.</p>
            )}
            {country.obligation && <p class="obligation prose">{country.obligation}</p>}
          </section>
        )
      }

      {
        !placeholder && (
          <section class="block block--subject" aria-labelledby="std-h">
            <h2 class="section-h" id="std-h">Standards and algorithms</h2>
            {familyItems.length === 0 && algorithmItems.length === 0 && <p class="empty std-empty">No standards or algorithms recorded.</p>}
            <dl class="data">
              {familyItems.length > 0 && (
                <div>
                  <dt>Standard families</dt>
                  <dd>
                    {familyItems.map((f, i) => (
                      <>
                        {i > 0 && ', '}
                        {f.href ? <a href={f.href}>{f.text}</a> : f.text}
                      </>
                    ))}
                  </dd>
                </div>
              )}
              {algorithmItems.length > 0 && (
                <div>
                  <dt>Algorithms</dt>
                  <dd class="mono">
                    {algorithmItems.map((a, i) => (
                      <>
                        {i > 0 && ', '}
                        {a.href ? <a href={a.href}>{a.text}</a> : a.text}
                      </>
                    ))}
                  </dd>
                </div>
              )}
              <div>
                <dt>Hybrid stance</dt>
                <dd>{hybrid}</dd>
              </div>
            </dl>
          </section>
        )
      }

      {
        !placeholder && participation.length > 0 && (
          <section class="block" aria-labelledby="proc-h">
            <h2 class="section-h" id="proc-h">International standards processes</h2>
            <ul class="actors">
              {participation.map((p) => (
                <li>
                  <span class="actor-name">{p.name}</span>
                  {p.role && <span class="actor-role">{p.role}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        !placeholder && (
          <section class="block" aria-labelledby="bodies-h">
            <h2 class="section-h" id="bodies-h">Governmental and standards bodies</h2>
            {govActors.length ? (
              <ul class="actors">
                {govActors.map((a) => {
                  const href = orgLink(a.name);
                  return (
                    <li>
                      {href ? (
                        <a class="actor-name row-link" href={href}>
                          {a.name}
                        </a>
                      ) : (
                        <span class="actor-name">{a.name}</span>
                      )}
                      {a.role && <span class="actor-role">{a.role}</span>}
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p class="empty">No institutional actors recorded.</p>
            )}
          </section>
        )
      }

      {
        members.length > 0 && (
          <section class="block" id="member-states" aria-labelledby="members-h">
            <h2 class="section-h" id="members-h">Member States</h2>
            <p class="members-lede">
              The <span class="mono">{members.length}</span> EU Member States, each with its own profile. EU law reaches every one of them;
              each keeps its own coordination posture.
            </p>
            <ul class="members">
              {members.map((m) => (
                <li>
                  {m.href ? (
                    <a class="row-link" href={m.href}>
                      {m.name}
                    </a>
                  ) : (
                    m.name
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        docs.length > 0 ? (
          <section class="block block--subject" id="documents" aria-labelledby="docs-h">
            <h2 class="section-h" id="docs-h">Key institutional documents</h2>
            {docGroups.map((g) => {
              const list = (
                <ul class="docs">
                  {g.items.map((d) => (
                    <li>
                      <span class="doc-text">
                        {d.url ? (
                          <a class="doc-title row-link" href={d.url} target="_blank" rel="noopener">
                            {d.title}
                          </a>
                        ) : (
                          <span class="doc-title">{d.title}</span>
                        )}
                        {d.meta && <span class="doc-meta">{d.meta}</span>}
                      </span>
                      {d.rowHref && (
                        <a class="doc-row row-link" href={d.rowHref}>
                          Entry in Documents<span class="sr-only">: {d.title}</span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              );
              return g.more ? (
                <details class="docs-more" data-profile-open>
                  <summary>
                    <span class="when-shut">
                      Show all <span class="mono">{docs.length}</span> documents
                    </span>
                    <span class="when-open">Show fewer</span>
                  </summary>
                  {list}
                </details>
              ) : (
                list
              );
            })}
            {allDocsHref && (
              <p class="all-docs">
                <a href={allDocsHref}>{docs.length === 1 ? 'Open it in Documents' : 'Open them in Documents'}</a>
              </p>
            )}
          </section>
        ) : placeholder ? (
          <p class="placeholder-line">
            The Atlas holds no institutional document for {inSentence}{placeholderAsOf ? <> as of <span class="mono">{placeholderAsOf}</span>.</> : '.'} Know an official document we have missed? <a href={reportHref}>Report it</a>.
          </p>
        ) : (
          <section class="block block--subject" id="documents" aria-labelledby="docs-h">
            <h2 class="section-h" id="docs-h">Key institutional documents</h2>
            <p class="empty">
              The Atlas holds no institutional document for {inSentence}. Know an official document we have missed? <a href={reportHref}>Report it</a>.
            </p>
          </section>
        )
      }

      {
        !placeholder && (
          <section class="fr-about about-page" id="cite" aria-labelledby="about-h">
            <details class="fr-about-d" data-profile-open>
              <summary class="fr-about-sum">
                <h2 class="fr-h" id="about-h">About this page</h2>
              </summary>
              <dl class="fr-kv">
                <div>
                  <dt>Sources</dt>
                  <dd>
                    <p>
                      {docs.length ? (
                        <>
                          Built from <span class="mono">{docs.length}</span> institutional {docs.length === 1 ? 'document' : 'documents'}
                          {tierCounts.length > 0 && <>: {joinAnd(tierCounts)}</>}.
                        </>
                      ) : (
                        'No institutional document recorded.'
                      )}
                      {methodSources && (
                        <>
                          {' '}
                          <a class="fr-link" href={methodSources}>
                            How sources are tiered
                          </a>
                        </>
                      )}
                    </p>
                    {verifiedLabel && <p>{verifiedLabel}.</p>}
                  </dd>
                </div>
                <div>
                  <dt>How to cite</dt>
                  <dd>
                    <CiteThis text={citation} />
                  </dd>
                </div>
                <div class="fr-report-row">
                  <dt>Corrections</dt>
                  <dd>
                    <ReportError title={name} path={path} label="Report an error in this profile" />
                  </dd>
                </div>
              </dl>
            </details>
          </section>
        )
      }
    </div>
  </div>
</article>

<script>
  // Printing opens the rest of the documents and About this page, then puts both back as the
  // visitor left them.
  const folds = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-profile-open]'));
  let before: boolean[] = [];
  window.addEventListener('beforeprint', () => {
    before = folds.map((d) => d.open);
    folds.forEach((d) => (d.open = true));
  });
  window.addEventListener('afterprint', () => {
    folds.forEach((d, i) => (d.open = before[i] ?? d.open));
  });
</script>

<style>
  .profile {
    max-width: none;
  }
  /* preview only: one line on the preview rule, in the interface face (it is a sentence) */
  .mirror-note {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule-preview);
    font-family: var(--font-instrument);
    font-size: var(--type-caption);
    color: var(--ink);
  }
  .profile-head {
    margin-bottom: var(--gap-related);
  }
  .title-row {
    display: flex;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    flex-wrap: wrap;
  }
  .profile-head h1 {
    font-family: var(--font-reading);
    font-size: var(--type-h1);
    font-weight: var(--weight-heading);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .member-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--gap-inline);
    margin: var(--gap-mark) 0 0;
    font-size: var(--type-small);
    color: var(--ink-muted);
  }
  .member-line a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
  .member-line .sep {
    color: var(--ink-muted);
  }

  /* Under 980px one column in reading order: the timeline, the rail, then the reading column,
     a section's gap apart. From 980px the timeline heads the reading column and the rail stands
     beside both, its first label level with the timeline's heading; the reading column holds the
     left edge and the rail's right edge meets the shell's. Whitespace parts them, never a rule. */
  .profile-body {
    display: grid;
    gap: var(--gap-related);
  }
  .profile-main,
  .lead-block {
    min-width: 0;
  }
  @media (min-width: 980px) {
    .profile-body {
      grid-template-columns: minmax(0, 40rem) 14rem;
      justify-content: space-between;
      align-items: start;
      gap: 0 var(--space-12);
    }
    .lead-block {
      grid-column: 1;
      grid-row: 1;
    }
    .profile-main {
      grid-column: 1;
      grid-row: 2;
    }
    .ataglance {
      grid-column: 2;
      grid-row: 1 / span 2;
      position: sticky;
      top: var(--space-8);
    }
    .has-lead .profile-main {
      margin-top: var(--gap-related);
    }
    .profile-body.is-placeholder {
      grid-template-columns: minmax(0, 40rem);
    }
  }

  /* ---- the rail: the posture with its confidence, the standards role, the Updated date --------- */
  .ataglance {
    padding-top: 0.35rem; /* its first label stands level with the timeline's heading */
  }
  .ag-list {
    margin: 0;
    display: grid;
    gap: var(--gap-group);
  }
  .ag-item {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .ag-list dt {
    font-size: var(--type-small);
    line-height: var(--leading-snug);
    color: var(--ink-muted);
  }
  .ag-list dd {
    margin: 0;
    font-size: var(--type-small);
    color: var(--ink);
  }
  .ag-list dd :global(.process-chip),
  .ag-list dd :global(.role-badge) {
    font-size: var(--type-control);
    color: var(--ink);
  }
  .ag-list dd :global(.role-badge) {
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .ag-sub {
    display: block;
    margin-top: 2px;
    font-size: var(--type-small);
    color: var(--ink-muted);
