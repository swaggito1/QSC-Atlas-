---
// The sources list under every lab tool, in APA 7 style, set in the reading face, with
// working links. Entries are sorted by author then date, as APA orders a reference list.
// Page ranges are written with "to", following the house rule on dashes. The entry is set in
// Newsreader at the body step and held to the reading measure; the address is a teal link in the
// interface face at the small step (an address is words, not a code, so it is not set in mono).
// At phone width a long address breaks at its own boundaries: it is split into pieces after each
// "/" and before each "?", "&" and "#", and a line breaks between pieces. Only a piece wider than
// the whole line breaks inside itself, at its own hyphens first.
import { apaParts, sortSources, sourceHref } from '../../lib/lab/format';
import type { SourceEntry } from '../../lib/lab/format';

interface Props {
  entries: SourceEntry[];
}
const entries = sortSources(Astro.props.entries ?? []);

function pieces(href: string): string[] {
  const scheme = href.match(/^[a-z][a-z0-9+.-]*:\/\//i)?.[0] ?? '';
  const parts = href
    .slice(scheme.length)
    .split(/(?<=\/)|(?=[?&#])/)
    .filter(Boolean);
  if (parts.length === 0) return [href];
  parts[0] = scheme + parts[0];
  return parts;
}
---

{
  entries.length > 0 && (
    <ol class="apa">
      {entries.map((e) => {
        const href = sourceHref(e);
        return (
          <li>
            {apaParts(e).map((p) => (p.i ? <i>{p.t}</i> : p.t))}
            {href && (
              <a class="apa-url" href={href} rel="noopener">{pieces(href).map((p) => <span class="apa-seg">{p}</span>)}</a>
            )}
          </li>
        );
      })}
    </ol>
  )
}

<style>
  .apa {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    font-family: var(--font-reading);
    font-size: var(--type-body);
    line-height: var(--leading-normal);
    max-width: var(--measure);
  }
  .apa li {
    padding-left: 2em;
    text-indent: -2em; /* APA hanging indent */
    overflow-wrap: anywhere;
  }
  .apa-url {
    font-family: var(--font-instrument);
    font-size: var(--type-small);
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .apa-url:hover,
  .apa-url:active {
    color: var(--accent-strong);
  }
  /* each piece is an atomic inline, so a line breaks between pieces and not inside one; an
     underline does not reach into inline blocks, so each piece draws its own; the hanging
     indent is inherited and is reset here */
  .apa-seg {
    display: inline-block;
    max-width: 100%;
    text-indent: 0;
    text-decoration: inherit;
    overflow-wrap: anywhere;
  }
  @media (prefers-reduced-motion: reduce) {
    .apa-url {
      transition: none;
    }
  }
</style>
