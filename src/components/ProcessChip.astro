---
// A country's coordination posture: a small coloured dot and its short label from POSTURE_META.
// No box, no border; colour and the word carry it together, the word at the small step beside
// the role badge's. With no posture recorded it says so in words, beside the pale dot the map
// and its key use for the same thing, and infers nothing.
import { postureMeta } from '../lib/process';

interface Props {
  value: string | null | undefined;
}
const { value } = Astro.props;
const meta = postureMeta(value);
---

{
  meta ? (
    <span class="process-chip" style={`--chip:${meta.color}`}>
      <span class="dot" aria-hidden="true" />
      {meta.short}
    </span>
  ) : (
    <span class="process-chip process-chip--none">
      <span class="dot dot--none" aria-hidden="true" />
      No coordination posture recorded
    </span>
  )
}

<style>
  .process-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-inline);
    font-family: var(--font-instrument);
    font-size: var(--type-small);
    color: var(--ink);
    white-space: nowrap;
  }
  .dot {
    width: 0.6em;
    height: 0.6em;
    border-radius: var(--radius-mark);
    background: var(--chip);
    flex: none;
  }
  .dot--none {
    background: var(--process-none);
    box-shadow: inset 0 0 0 1px var(--swatch-none-edge);
  }
  .process-chip--none {
    color: var(--ink-muted);
    white-space: normal;
  }
</style>
